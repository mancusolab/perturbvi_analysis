complexplot_gene_perturbation <- function(effect_df,
                                          effect_name = "PerturbVI\nOverall effect",
                                          show_row_name = T,
                                          cluster_col = F,
                                          score_break = c(-0.3, -0.2, -0.1, 0, 0.1, 0.2, 0.3),
                                          color_break = c("#07006b","#1200f9", "#7166ff","grey95","#e7767f","#e83828","#bf3d22"),
                                          legend_title_fontsize = 20, 
                                          legend_label_fontsize = 18,
                                          row_names_fontsize = 14){
  # reorder the dataframe by pathway
  effect_df = effect_df[order(effect_df$pathway), ]
  # extract numeric column
  numeric_columns <- sapply(effect_df, is.numeric)
  effect_mat = as.matrix(effect_df[,numeric_columns])
  rownames(effect_mat) = effect_df$gene
  
  # factorize pathway
  effect_df$pathway <- factor(effect_df$pathway, levels = unique(effect_df$pathway))
  
  lgd_list <- list()
  col_fun <- circlize::colorRamp2(breaks = score_break, colors = color_break)
  lgd_list[["effectsize"]] <- Legend(title = effect_name,
                                     at = score_break,
                                     col_fun = col_fun,
                                     legend_gp = gpar(fontsize = 20))  # Title fontsize for legends
  
  marker_colormap <- structure(pathway_colormap[1:length(levels(effect_df$pathway))],
                               names = levels(effect_df$pathway))
  lgd_list[["Marker"]] <- Legend(title = "Gene annotation",
                                 labels = levels(effect_df$pathway),
                                 at = levels(effect_df$pathway),
                                 legend_gp = gpar(fill = marker_colormap, fontsize = 20))  # Label fontsize for legends
  
  right_annot <- rowAnnotation(Marker = effect_df$pathway,
                               col = list(Marker = marker_colormap),
                               annotation_legend_param = list(
                                 Marker = list(
                                   title = "Marker annotation",
                                   at = levels(effect_df$pathway),
                                   labels = levels(effect_df$pathway),
                                   legend_gp = gpar(fontsize = 20)  # Adjust font size for labels within annotations
                                 )
                               ),
                               show_annotation_name = F,
                               show_legend = F)
  
  map1 <- Heatmap(effect_mat,
                  name = effect_name,
                  col = col_fun,
                  rect_gp = gpar(pathway = "none"),
                  border_gp = gpar(col = "black"),
                  row_title = "Downstream genes",
                  column_title = "Perturbations",
                  cluster_rows = F, cluster_columns = cluster_col,
                  show_row_dend = FALSE, 
                  show_column_dend = FALSE, 
                  right_annotation = right_annot,
                  show_heatmap_legend = F,
                  show_row_names = show_row_name,
                  row_names_gp = gpar(fontsize = row_names_fontsize), 
                  column_names_rot = 45,
                  column_names_side = "top",
                  column_title_side = "bottom",
                  column_title_gp = gpar(fontface = "bold", fontsize = 14), 
                  row_title_gp = gpar(fontface = "bold", fontsize = 14))
  
  draw(map1, annotation_legend_list = lgd_list)
}




complexplot_gene_perturbation <- function(effect_df,
                                          clus_row = F,
                                          clus_col = T,
                                          show_row_name = T,
                                          effect_name = "PerturbVI\nOverall effect",
                                          score_break = c(-0.4,-0.3, -0.2, -0.1, 0, 0.1, 0.2, 0.3,0.4),
                                          color_break = c("#00004d","#1034A6","#1200f9", "#7166ff","grey95","#e7767f","#e83828","#bf3d22","#8A0000"),
                                          pathway_order = NULL, # Custom order for pathway levels
                                          within_group_order = NULL){
  
  # factorize pathway
  # Custom order for pathway levels
  if (!is.null(pathway_order)) {
    effect_df$pathway <- factor(effect_df$pathway, levels = pathway_order)
  } else {
    effect_df$pathway <- factor(effect_df$pathway, levels = unique(effect_df$pathway))
  }
  
  
  # Custom within-group ordering
  if (!is.null(within_group_order)) {
    # Assuming within_group_order is a named list with names as pathway levels and each element as a vector of gene names in the desired order
    effect_df <- effect_df[with(effect_df, order(pathway, match(gene, unlist(within_group_order[pathway])))), ]
  }
  
  #reorder the dataframe by pathway
  effect_df = effect_df[order(effect_df$pathway), ]
  #extract numeric column
  numeric_columns <- sapply(effect_df, is.numeric)
  effect_mat = as.matrix(effect_df[,numeric_columns])
  rownames(effect_mat) = effect_df$gene
  
  lgd_list <- list()
  col_fun <- circlize::colorRamp2(breaks = score_break,
                                  colors = color_break)
  lgd_list[["effectsize"]] <- Legend(title = effect_name,
                                     at = score_break,
                                     col_fun = col_fun)
  
  marker_colormap <- structure(pathway_colormap[1:length(levels(effect_df$pathway))],
                               names = levels(effect_df$pathway))
  lgd_list[["Marker"]] <-  Legend(title = "Marker annotation",
                                  labels = levels(effect_df$pathway),
                                  at = levels(effect_df$pathway),
                                  legend_gp = gpar(fill = marker_colormap))
  right_annot <- rowAnnotation(Marker = effect_df$pathway,
                               col = list(Marker = marker_colormap),
                               annotation_legend_param = list(
                                 Marker = list(
                                   title = "Marker annotation",
                                   at = levels(effect_df$pathway),
                                   labels = levels(effect_df$pathway)
                                 )
                               ),
                               show_annotation_name = F,
                               show_legend = F)
  
  map1 <-   Heatmap(effect_mat,
                    name = effect_name,
                    col = col_fun,
                    rect_gp = gpar(pathway = "none"),
                    border_gp = gpar(col = "black"),
                    row_title = "Downstream genes",
                    column_title = "Perturbations",
                    cluster_rows = clus_row, 
                    cluster_columns = clus_col,
                    show_row_dend = FALSE, 
                    show_column_dend = FALSE, 
                    right_annotation = right_annot,
                    show_heatmap_legend = F,
                    show_row_names = show_row_name,
                    row_names_gp = gpar(fontsize = 14),
                    column_names_gp = gpar(fontsize = 14),
                    column_names_rot = 45,
                    column_names_side = "top",
                    column_title_side = "bottom",
                    column_title_gp = gpar(fontface = "bold", fontsize = 14), 
                    row_title_gp = gpar(fontface = "bold", fontsize = 14))
  
  draw(map1, annotation_legend_list = lgd_list)
}



complexplot_gene_perturbation <- function(effect_df,clus_row = F,
                                          effect_name = "PerturbVI\nOverall effect",
                                          score_break = c(-0.3, -0.2, -0.1, 0, 0.1, 0.2, 0.3),
                                          color_break = c("#07006b","#1200f9", "#7166ff","grey95","#e7767f","#e83828","#bf3d22")){
  #reorder the dataframe by pathway
  effect_df = effect_df[order(effect_df$pathway), ]
  #extract numeric column
  numeric_columns <- sapply(effect_df, is.numeric)
  effect_mat = as.matrix(effect_df[,numeric_columns])
  rownames(effect_mat) = effect_df$gene
  
  #factorize pathway
  effect_df$pathway <- factor(effect_df$pathway, levels = unique(effect_df$pathway))


  lgd_list <- list()
  col_fun <- circlize::colorRamp2(breaks = score_break,
                                  colors = color_break)
  lgd_list[["effectsize"]] <- Legend(title = effect_name,
                                     at = score_break,
                                     col_fun = col_fun)
  
  marker_colormap <- structure(pathway_colormap[1:length(levels(effect_df$pathway))],
                               names = levels(effect_df$pathway))
  lgd_list[["Marker"]] <-  Legend(title = "Marker annotation",
                                  labels = levels(effect_df$pathway),
                                  at = levels(effect_df$pathway),
                                  legend_gp = gpar(fill = marker_colormap))
  right_annot <- rowAnnotation(Marker = effect_df$pathway,
                               col = list(Marker = marker_colormap),
                               annotation_legend_param = list(
                                 Marker = list(
                                   title = "Marker annotation",
                                   at = levels(effect_df$pathway),
                                   labels = levels(effect_df$pathway)
                                 )
                               ),
                               show_annotation_name = F,
                               show_legend = F)
  if (clus_row == T){
    map1 <- Heatmap(effect_mat,
                    name = effect_name,
                    col = col_fun,
                    rect_gp = gpar(pathway = "none"),
                    border_gp = gpar(col = "black"),
                    row_title = "Neuron marker genes",
                    column_title = "Perturbations",
                    cluster_rows = T, cluster_columns = F,
                    show_row_dend = FALSE, # Do not show row dendrogram
                    show_column_dend = FALSE, # Do not show column dendrogram
                    right_annotation = right_annot,
                    show_heatmap_legend = F,
                    row_names_gp = gpar(fontsize = 10.5),
                    column_names_rot = 45,
                    column_names_side = "top",
                    column_title_side = "bottom")
  }
  else{  
    map1 <- Heatmap(effect_mat,
                         name = effect_name,
                         col = col_fun,
                         rect_gp = gpar(pathway = "none"),
                         border_gp = gpar(col = "black"),
                         row_title = "Neuron marker genes",
                         column_title = "Perturbations",
                         cluster_rows = F, cluster_columns = F,
                         show_row_dend = FALSE, # Do not show row dendrogram
                         show_column_dend = FALSE, # Do not show column dendrogram
                         right_annotation = right_annot,
                         show_heatmap_legend = F,
                         row_names_gp = gpar(fontsize = 10.5),
                         column_names_rot = 45,
                         column_names_side = "top",
                         column_title_side = "bottom")}

  draw(map1, annotation_legend_list = lgd_list)
}


